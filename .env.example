# Copy to .env and fill in. Commented-out lines show the defaults.

# --- Telegram ---
BOT_TOKEN=
OWNER_ID=
# ALLOWED_THREAD_ID=0

# --- LLM: FreeLLMAPI router with fallback to direct Gemini (see README, "LLM provider") ---
# freellmapi_with_fallback (default) | freellmapi (router only, never falls back) | direct (Gemini only)
LLM_PROVIDER=freellmapi_with_fallback
# Must end with /v1. On Railway: http://<freellmapi service>.railway.internal:3001/v1
# Empty -> the default provider uses direct Gemini only.
LLM_BASE_URL=
# The unified key from the FreeLLMAPI dashboard (Keys page header), starts with freellmapi-
LLM_API_KEY=
# auto = the active fallback chain; auto:<profile> = a named profile
LLM_MODEL=auto
# A profile made only of image-capable models
LLM_VISION_MODEL=auto:vision
# LLM_TIMEOUT_MS=12000
# LLM_VISION_TIMEOUT_MS=25000
# json_schema | json_object
# LLM_JSON_MODE=json_schema
# Thinking effort the router sends for the cover steps; empty = don't send
# LLM_COVER_REASONING_EFFORT=minimal
# Log every LLM call (via/model/latency) to stdout
# LLM_DEBUG=1

# Direct Gemini: the fallback, and the only LLM with LLM_PROVIDER=direct
GEMINI_API_KEY=

# --- Search thresholds ---
# Below this, a cover read is rejected ("Не уверен в названии")
# PHOTO_MIN_CONFIDENCE=0.65
# Below this, text search warns about low confidence but still searches
# TEXT_LOW_CONFIDENCE=0.25

# --- Book sources ---
GOOGLE_BOOKS_API_KEY=
# FLIBUSTA_BASE_URL=https://flibusta.is

# --- Storage and limits ---
# DATA_DIR=./data
# DB_FILE=./data/bot.sqlite3
# DAILY_LIMIT=15

# --- Kindle delivery: Resend if RESEND_API_KEY is set, otherwise SMTP ---
# RESEND_API_KEY=
# RESEND_FROM=onboarding@resend.dev
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# --- Owner-only debug output ---
# RAW_MODE=1
# FLIBUSTA_DEBUG=1
# LLM steps (via/model/latency, retries, fallbacks) for text and photo search
# GEMINI_DEBUG=1
# DEBUG_ERRORS=1

# --- Only for migrating an old JSON-file install (not needed for new deploys) ---
# ACCESS_FILE=./data/access.json
# KINDLE_FILE=./data/kindle.json
# LIMITS_FILE=./data/limits.json
